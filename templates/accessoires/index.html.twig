{% extends 'base.html.twig' %}

{% block title %}Nos Accessoires & Équipements — MHvolt{% endblock %}

{% block content %}
    <section class="py-5 bg-white">
        <div class="container py-3">
            <div class="text-center mb-5" data-aos="fade-up">
                <span class="text-uppercase tracking-wider small fw-semibold text-muted">Boutique</span>
                <h1 class="display-5 fw-bold text-dark mt-1">Nos Accessoires</h1>
                <p class="text-secondary mx-auto mt-2" style="max-width: 600px;">
                    Optimisez la sécurité, le confort et les performances de votre trottinette avec notre sélection d'équipements certifiés.
                </p>
            </div>

            {% set items = accessories|default(accessoires|default([])) %}

            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
                {% for item in items %}
                    {% set imgObj = item.illustrations|first %}
                    {% set rawImg = imgObj ? imgObj.image : (item.image ?? 'default.jpg') %}
                    {% set imgPath = rawImg starts with 'http' ? rawImg : '/uploads/accessoires/' ~ rawImg %}
                    {% set priceTTC = item.price %}
                    {% set promoTTC = (item.promoPrice is defined and item.promoPrice is not null and item.promoPrice > 0 and item.promoPrice < item.price) ? item.promoPrice : null %}

                    <div class="col" data-aos="fade-up" data-aos-duration="600">
                        <div class="card h-100 border border-light-subtle rounded-4 p-3 bg-white product-card shadow-sm">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-light text-secondary fw-normal border">Accessoire</span>
                                    {% if promoTTC %}
                                        <span class="badge bg-danger rounded-pill px-2 py-1 fw-semibold" style="font-size: 0.65rem;">Promo</span>
                                    {% endif %}
                                </div>
                                {% if item.stock is defined and item.stock < 1 %}
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rupture</span>
                                {% else %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">En stock</span>
                                {% endif %}
                            </div>

                            <a href="{{ path('accessory_show', { 'slug': item.slug }) }}" class="d-flex align-items-center justify-content-center my-3 text-decoration-none" style="height: 180px;">
                                <img src="{{ imgPath }}"
                                     alt="{{ item.name }}"
                                     class="img-fluid object-fit-contain h-100 w-100 product-img-zoom">
                            </a>

                            <div class="card-body p-0 pt-2 d-flex flex-column justify-content-end">
                                <h3 class="fs-6 fw-bold text-dark mb-1 text-truncate" title="{{ item.name }}">
                                    <a href="{{ path('accessory_show', { 'slug': item.slug }) }}" class="text-dark text-decoration-none">
                                        {{ item.name }}
                                    </a>
                                </h3>

                                <div class="d-flex justify-content-between align-items-baseline mb-3">
                                    <div class="d-flex align-items-baseline gap-2">
                                        {% if promoTTC %}
                                            <span class="fs-5 fw-bold text-dark">{{ promoTTC|number_format(2, ',', ' ') }}&nbsp;€</span>
                                            <del class="small text-danger fw-semibold" style="text-decoration: line-through !important;">{{ priceTTC|number_format(2, ',', ' ') }}&nbsp;€</del>
                                        {% else %}
                                            <span class="fs-5 fw-bold text-dark">{{ priceTTC|number_format(2, ',', ' ') }}&nbsp;€</span>
                                        {% endif %}
                                    </div>
                                    <span class="text-secondary small fw-medium">TTC</span>
                                </div>

                                <a href="{{ path('accessory_show', { 'slug': item.slug }) }}" class="btn btn-outline-dark rounded-pill w-100 btn-sm py-2 fw-medium">
                                    Découvrir l'accessoire
                                </a>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center py-5 text-secondary">
                        <p>Aucun accessoire disponible actuellement.</p>
                    </div>
                {% endfor %}
            </div>

            {% if items is iterable and items|length > 0 and knp_pagination_render is defined %}
                <div class="d-flex justify-content-center mt-5">
                    {{ knp_pagination_render(items) }}
                </div>
            {% endif %}
        </div>
    </section>
{% endblock %}
