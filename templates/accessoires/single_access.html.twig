{% set imgObj = accessory.illustrations|first %}
{% set rawImg = imgObj ? imgObj.image : (accessory.image ?? 'default.jpg') %}
{% set imgPath = rawImg starts with 'http' ? rawImg : '/uploads/accessoires/' ~ rawImg %}
{% set tvaRate = accessory.tva ? (accessory.tva.value / 100) : 0.2 %}
{% set priceTTC = accessory.price * (1 + tvaRate) %}
{% set promoTTC = (accessory.promoPrice is defined and accessory.promoPrice is not null and accessory.promoPrice > 0) ? (accessory.promoPrice * (1 + tvaRate)) : null %}

<div class="card h-100 border border-light-subtle rounded-4 p-3 bg-white product-card shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex align-items-center gap-1">
            <span class="badge bg-light text-secondary fw-normal border">Accessoire</span>
            {% if promoTTC %}
                <span class="badge bg-danger rounded-pill px-2 py-1 fw-semibold" style="font-size: 0.65rem;">Promo</span>
            {% endif %}
        </div>
        {% if accessory.stock is defined and accessory.stock < 1 %}
            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Rupture</span>
        {% else %}
            <span class="badge bg-success-subtle text-success border border-success-subtle">En stock</span>
        {% endif %}
    </div>

    <a href="{{ path('accessory_show', { 'slug': accessory.slug }) }}" class="d-flex align-items-center justify-content-center my-3 text-decoration-none" style="height: 180px;">
        <img src="{{ imgPath }}"
             alt="{{ accessory.name }}"
             class="img-fluid object-fit-contain h-100 w-100 product-img-zoom">
    </a>

    <div class="card-body p-0 pt-2 d-flex flex-column justify-content-end">
        <h3 class="fs-6 fw-semibold text-dark mb-1 text-truncate">
            <a href="{{ path('accessory_show', { 'slug': accessory.slug }) }}" class="text-dark text-decoration-none">
                {{ accessory.name }}
            </a>
        </h3>

        <div class="d-flex justify-content-between align-items-baseline mb-3">
            <div>
                {% if promoTTC %}
                    <span class="fs-5 fw-bold text-danger">{{ promoTTC|number_format(2, ',', ' ') }} €</span>
                    <span class="text-muted text-decoration-line-through small ms-1">{{ priceTTC|number_format(2, ',', ' ') }} €</span>
                {% else %}
                    <span class="fs-5 fw-bold text-dark">{{ priceTTC|number_format(2, ',', ' ') }} €</span>
                {% endif %}
            </div>
            <span class="text-secondary small">TTC</span>
        </div>

        <a href="{{ path('accessory_show', { 'slug': accessory.slug }) }}" class="btn btn-outline-dark rounded-pill w-100 btn-sm py-2 fw-medium">
            Découvrir
        </a>
    </div>
</div>
