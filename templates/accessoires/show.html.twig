{% extends 'base.html.twig' %}

{% block title %}{{ accessory.name }} — MHvolt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/products.css') }}">
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/product-zoom.js') }}" defer></script>
{% endblock %}

{% block content %}

    <div class="container py-5">
        {# Fil d'Ariane #}
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-secondary text-decoration-none">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('accessoires') }}" class="text-secondary text-decoration-none">Accessoires</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">{{ accessory.name }}</li>
            </ol>
        </nav>

        <div class="row g-5">
            {# 📷 Colonne Gauche : Galerie Photos avec Zoom Interactif #}
            <div class="col-lg-7">
                <div class="position-sticky" style="top: 100px;">
                    <div id="accessoryZoomContainer" class="product-zoom-container">
                        {% set firstImg = illustrations|first %}
                        {% set rawImg = firstImg ? firstImg.image : (accessory.image ?? 'default.jpg') %}
                        {% set imgPath = rawImg starts with 'http' ? rawImg : '/uploads/accessoires/' ~ rawImg %}
                        <img id="mainAccessoryImage"
                             src="{{ imgPath }}"
                             alt="{{ accessory.name }}"
                             class="img-fluid object-fit-contain w-100 h-100 product-zoom-image">
                    </div>

                    {% if illustrations|length > 1 %}
                        <div class="d-flex gap-2 overflow-x-auto pb-2">
                            {% for item in illustrations %}
                                {% set rawItemImg = item.image %}
                                {% set itemImgPath = rawItemImg starts with 'http' ? rawItemImg : '/uploads/accessoires/' ~ rawItemImg %}
                                <button type="button"
                                        class="btn p-1 border rounded-3 bg-white accessory-thumb-btn {% if loop.first %}border-dark{% else %}border-light-subtle{% endif %}"
                                        data-img-src="{{ itemImgPath }}"
                                        style="width: 72px; height: 72px; flex-shrink: 0;">
                                    <img src="{{ itemImgPath }}" alt="Miniature" class="w-100 h-100 object-fit-contain">
                                </button>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            {# 💳 Colonne Droite : Bloc d'Achat Sticky #}
            <div class="col-lg-5">
                <div class="ps-lg-3">
                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-light text-secondary border">Équipement certifié</span>

                            {# 🔗 Bouton d'accès direct aux trottinettes compatibles #}
                            <a href="{{ path('accessoire_trottinettes', {'slug': accessory.slug}) }}"
                               class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1 fw-medium d-inline-flex align-items-center gap-1 shadow-sm"
                               style="font-size: 0.75rem;">
                                <i class="bx bx-bolt"></i>
                                <span>Trottinettes compatibles</span>
                            </a>
                        </div>
                        <h1 class="display-6 fw-bold text-dark mb-2">{{ accessory.name }}</h1>
                        {% if accessory.description %}
                            <div class="text-secondary small mb-0 lh-base">
                                {{ accessory.description|raw }}
                            </div>
                        {% endif %}
                    </div>

                    {# Prix public TTC direct #}
                    {% set priceTTC = accessory.price %}
                    {% set promoPrice = priceTTC %}

                    {% if accessory.promoPrice is defined and accessory.promoPrice is not null and accessory.promoPrice > 0 and accessory.promoPrice < accessory.price %}
                        {% set promoPrice = accessory.promoPrice %}
                    {% elseif promotion and promotion.autoApply %}
                        {% if promotion.targetType == 'all'
                            or (promotion.targetType == 'product' and promotion.product.id == accessory.id)
                            or (promotion.targetType == 'product_list' and accessory in promotion.products) %}
                            {% if promotion.discountAmount is not null %}
                                {% set promoPrice = accessory.price - promotion.discountAmount %}
                            {% elseif promotion.discountPercent is not null %}
                                {% set promoPrice = accessory.price * (1 - promotion.discountPercent / 100) %}
                            {% endif %}
                        {% endif %}
                    {% endif %}

                    {% set hasDirectPromo = accessory.promoPrice is not null and accessory.promoPrice > 0 and accessory.promoPrice < accessory.price %}
                    {% set activePromoPrice = hasDirectPromo ? accessory.promoPrice : (promoPrice|default(null)) %}

                    {# Bloc Prix avec classes CSS dédiées #}
                    <div class="bg-body-tertiary border border-light-subtle rounded-4 p-4 mb-4">
                        <div class="d-flex align-items-center flex-wrap mb-2">
                            {% if activePromoPrice and activePromoPrice < accessory.price %}
                                <span class="price-promo-main">
                                    {{ activePromoPrice|number_format(2, ',', ' ') }}&nbsp;€
                                </span>
                                <del class="price-del-base">
                                    {{ accessory.price|number_format(2, ',', ' ') }}&nbsp;€
                                </del>
                                <span class="badge-promo-pill">
                                    Promo
                                </span>
                            {% else %}
                                <span class="price-single-main">
                                    {{ accessory.price|number_format(2, ',', ' ') }}&nbsp;€
                                </span>
                            {% endif %}
                            <span class="text-secondary small fw-medium">
                                TTC
                            </span>
                        </div>

                        {# Stock & Actions #}
                        {% if accessory.stock < 1 %}
                            <div class="d-flex align-items-center text-danger small fw-semibold">
                                <i class="bx bx-x-circle me-1 fs-5"></i> Bientôt de retour
                            </div>
                        {% else %}
                            <div class="d-flex align-items-center text-success small fw-semibold mb-3">
                                <i class="bx bx-check-circle me-1 fs-5"></i> En stock ({{ accessory.stock }} restants)
                            </div>

                            {% set product_id = accessory.id %}
                            {% set cart_data = cart.get() ?? {} %}
                            {% set quantity_in_cart = cart_data['accessory'][product_id]|default(0) %}

                            <div class="d-flex flex-column gap-2">
                                {% if quantity_in_cart == 0 %}
                                    <a href="{{ path('add_to_cart', {'id': product_id, 'type': 'accessory'}) }}"
                                       class="btn btn-dark rounded-pill py-3 fw-semibold text-center w-100 shadow-sm">
                                        <i class="bx bx-shopping-bag me-1"></i> Ajouter au panier
                                    </a>
                                {% else %}
                                    <div class="d-flex align-items-center justify-content-between bg-white border rounded-pill p-2">
                                        <a href="{{ path('decrease_to_cart', {'id': product_id, 'type': 'accessory'}) }}" class="btn btn-light btn-sm rounded-circle">
                                            <i class="bx bx-minus"></i>
                                        </a>
                                        <span class="fw-bold small">{{ quantity_in_cart }} dans le panier</span>
                                        {% if quantity_in_cart < accessory.stock %}
                                            <a href="{{ path('add_to_cart', {'id': product_id, 'type': 'accessory'}) }}" class="btn btn-light btn-sm rounded-circle">
                                                <i class="bx bx-plus"></i>
                                            </a>
                                        {% else %}
                                            <button class="btn btn-light btn-sm rounded-circle" disabled>
                                                <i class="bx bx-lock"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                    <a href="{{ path('cart') }}" class="btn btn-outline-dark rounded-pill py-2 btn-sm fw-medium text-center">
                                        Voir mon panier <i class="bx bx-right-arrow-alt ms-1"></i>
                                    </a>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>

                    <div class="row g-2 text-secondary small">
                        <div class="col-6 d-flex align-items-center gap-2">
                            <i class="bx bx-shield-check fs-5 text-dark"></i> Pièce d'origine
                        </div>
                        <div class="col-6 d-flex align-items-center gap-2">
                            <i class="bx bx-truck fs-5 text-dark"></i> Expédition rapide
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
