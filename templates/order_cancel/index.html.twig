{% extends 'base.html.twig' %}

{% block title %}Paiement non abouti — MHvolt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/cart.css') }}">
{% endblock %}

{% block content %}
<div class="container py-5 order-result-container">
    <div class="card border border-light-subtle rounded-4 p-4 p-md-5 shadow-sm bg-white text-center">
        {# Icône d'alerte #}
        <div class="order-result-icon icon-cancel">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="15" y1="9" x2="9" y2="15"/>
                <line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
        </div>

        <span class="text-uppercase tracking-wider small fw-semibold text-danger">Transaction interrompue</span>
        <h1 class="fs-4 fw-bold text-dark mt-1 mb-2">Échec du règlement</h1>

        <p class="text-secondary small leading-relaxed mb-4">
            Bonjour <strong>{{ order.user.firstname }} {{ order.user.lastname }}</strong>,<br>
            Le paiement de votre commande <span class="font-monospace fw-semibold text-dark">#{{ order.reference }}</span> n'a pas été finalisé. Aucun montant n'a été prélevé sur votre compte bancaire.
        </p>

        <div class="bg-body-tertiary border rounded-3 p-3 mb-4 text-start small text-secondary">
            <div class="d-flex justify-content-between mb-1">
                <span>Numéro de référence :</span>
                <strong class="text-dark font-monospace">{{ order.reference }}</strong>
            </div>
            <div class="d-flex justify-content-between">
                <span>E-mail rattaché :</span>
                <span class="text-dark">{{ order.user.email }}</span>
            </div>
        </div>

        <div class="d-flex flex-column gap-2">
            <a href="{{ path('cart') }}" class="btn btn-dark rounded-pill py-2.5 fw-semibold shadow-sm">
                Retourner à mon panier
            </a>
            <a href="{{ path('app_home') }}#contact" class="btn btn-link text-secondary text-decoration-none small">
                Besoin d'aide ? Contacter le support client
            </a>
        </div>
    </div>
</div>
{% endblock %}
