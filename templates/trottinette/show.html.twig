{% extends 'base.html.twig' %}

{% block title %}{{ trottinette.name }} — MHvolt{% endblock %}

{% block content %}
    {% include 'partials/promos.html.twig' %}

    <div class="container py-5">
        {# Fil d'Ariane #}
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="{{ path('app_home') }}" class="text-secondary text-decoration-none">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('nos_trottinettes') }}" class="text-secondary text-decoration-none">Trottinettes</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">{{ trottinette.name }}</li>
            </ol>
        </nav>

        <div class="row g-5">
            {# 📷 Colonne Gauche : Galerie Photos avec Zoom Interactif #}
            <div class="col-lg-7">
                <div class="position-sticky" style="top: 100px;">
                    <div id="trottZoomContainer" class="bg-body-tertiary border border-light-subtle rounded-4 p-4 text-center mb-3 d-flex align-items-center justify-content-center overflow-hidden position-relative" style="min-height: 420px; max-height: 480px; cursor: zoom-in;">
                        {% set firstImg = illustrations|first %}
                        {% set rawImg = firstImg ? firstImg.image : (trottinette.image ?? 'default.jpg') %}
                        {% set imgPath = rawImg starts with 'http' ? rawImg : '/uploads/trottinettes/' ~ rawImg %}
                        <img id="mainProductImage"
                             src="{{ imgPath }}"
                             alt="{{ trottinette.name }}"
                             class="img-fluid object-fit-contain w-100 h-100"
                             style="max-height: 400px; transition: transform 0.2s ease, transform-origin 0.1s ease, opacity 0.2s ease;">
                    </div>

                    {% if illustrations|length > 1 %}
                        <div class="d-flex gap-2 overflow-x-auto pb-2">
                            {% for item in illustrations %}
                                {% set rawItemImg = item.image %}
                                {% set itemImgPath = rawItemImg starts with 'http' ? rawItemImg : '/uploads/trottinettes/' ~ rawItemImg %}
                                <button type="button"
                                        class="btn p-1 border rounded-3 bg-white product-thumb-btn {% if loop.first %}border-dark{% else %}border-light-subtle{% endif %}"
                                        onclick="changeMainImage('{{ itemImgPath }}', this)"
                                        style="width: 72px; height: 72px; flex-shrink: 0;">
                                    <img src="{{ itemImgPath }}" alt="Miniature" class="w-100 h-100 object-fit-contain">
                                </button>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            {# 💳 Colonne Droite : Bloc d'Achat Sticky #}
            <div class="col-lg-5">
                <div class="ps-lg-3">
                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-dark fw-normal border">Trottinette</span>
                                {% if trottinette.stock is defined and trottinette.stock < 1 %}
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-normal">Rupture de stock</span>
                                {% else %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle fw-normal">En stock</span>
                                {% endif %}
                            </div>

                            <a href="{{ path('trottinette_accessoires', {'slug': trottinette.slug}) }}"
                               class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1 fw-medium d-inline-flex align-items-center gap-1 shadow-sm"
                               style="font-size: 0.75rem;">
                                <i class="bx bx-package"></i>
                                <span>Accessoires compatibles</span>
                            </a>
                        </div>

                        <h1 class="display-6 fw-bold text-dark mb-2">{{ trottinette.name }}</h1>
                        <p class="text-secondary small mb-0">{{ trottinette.descriptionShort ?? 'Mobilité urbaine haute performance.' }}</p>
                    </div>

                    {# Calculs Prix & TVA (Prend en compte promoPrice direct OU promotion auto) #}
                    {% set tvaRate = trottinette.tva ? (trottinette.tva.value / 100) : 0.2 %}
                    {% set priceTTC = trottinette.price * (1 + tvaRate) %}
                    {% set promoPrice = priceTTC %}

                    {% if trottinette.promoPrice is defined and trottinette.promoPrice is not null and trottinette.promoPrice > 0 %}
                        {% set promoPrice = trottinette.promoPrice * (1 + tvaRate) %}
                    {% elseif promotion and promotion.autoApply %}
                        {% if promotion.targetType == 'all'
                            or (promotion.targetType == 'product' and promotion.product.id == trottinette.id)
                            or (promotion.targetType == 'product_list' and trottinette in promotion.products) %}
                            {% if promotion.discountAmount is not null %}
                                {% set promoPrice = (trottinette.price - promotion.discountAmount) * (1 + tvaRate) %}
                            {% elseif promotion.discountPercent is not null %}
                                {% set promoPrice = trottinette.price * (1 - promotion.discountPercent / 100) * (1 + tvaRate) %}
                            {% endif %}
                        {% endif %}
                    {% endif %}

                    {# Bloc Prix #}
                    <div class="bg-body-tertiary border border-light-subtle rounded-4 p-4 mb-4">
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            {% if promoPrice < priceTTC %}
                                <span class="fs-2 fw-bold text-danger">{{ promoPrice|number_format(2, ',', ' ') }} €</span>
                                <span class="fs-5 text-muted text-decoration-line-through">{{ priceTTC|number_format(2, ',', ' ') }} €</span>
                                <span class="badge bg-danger rounded-pill ms-2">Offre</span>
                            {% else %}
                                <span class="fs-2 fw-bold text-dark">{{ priceTTC|number_format(2, ',', ' ') }} €</span>
                            {% endif %}
                            <span class="text-secondary small">TTC</span>
                        </div>

                        {# Stock #}
                        {% if trottinette.stock < 1 %}
                            <div class="d-flex align-items-center text-danger small fw-semibold">
                                <i class="bx bx-x-circle me-1 fs-5"></i> Bientôt de retour en stock
                            </div>
                        {% else %}
                            <div class="d-flex align-items-center text-success small fw-semibold mb-3">
                                <i class="bx bx-check-circle me-1 fs-5"></i> Disponible ({{ trottinette.stock }} unités en stock)
                            </div>

                            {# Actions Panier #}
                            {% set product_id = trottinette.id %}
                            {% set cart_data = cart.get() ?? {} %}
                            {% set quantity_in_cart = cart_data['trottinette'][product_id]|default(0) %}

                            <div class="d-flex flex-column gap-2">
                                {% if quantity_in_cart == 0 %}
                                    <a href="{{ path('add_to_cart', {'id': product_id, 'type': 'trottinette'}) }}"
                                       class="btn btn-dark rounded-pill py-3 fw-semibold text-center w-100 shadow-sm">
                                        <i class="bx bx-shopping-bag me-1"></i> Ajouter au panier
                                    </a>
                                {% else %}
                                    <div class="d-flex align-items-center justify-content-between bg-white border rounded-pill p-2">
                                        <a href="{{ path('decrease_to_cart', {'id': product_id, 'type': 'trottinette'}) }}" class="btn btn-light btn-sm rounded-circle">
                                            <i class="bx bx-minus"></i>
                                        </a>
                                        <span class="fw-bold small">{{ quantity_in_cart }} dans le panier</span>
                                        {% if quantity_in_cart < trottinette.stock %}
                                            <a href="{{ path('add_to_cart', {'id': product_id, 'type': 'trottinette'}) }}" class="btn btn-light btn-sm rounded-circle">
                                                <i class="bx bx-plus"></i>
                                            </a>
                                        {% else %}
                                            <button class="btn btn-light btn-sm rounded-circle" disabled>
                                                <i class="bx bx-lock"></i>
                                            </button>
                                        {% endif %}
                                    </div>
                                    <a href="{{ path('cart') }}" class="btn btn-outline-dark rounded-pill py-2 btn-sm fw-medium text-center">
                                        Finaliser ma commande <i class="bx bx-right-arrow-alt ms-1"></i>
                                    </a>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>

                    {# Garanties sous le bouton #}
                    <div class="row g-2 text-secondary small">
                        <div class="col-6 d-flex align-items-center gap-2">
                            <i class="bx bx-shield-check fs-5 text-dark"></i> Garantie 2 ans
                        </div>
                        <div class="col-6 d-flex align-items-center gap-2">
                            <i class="bx bx-truck fs-5 text-dark"></i> Livraison sécurisée
                        </div>
                        <div class="col-6 d-flex align-items-center gap-2">
                            <i class="bx bx-wrench fs-5 text-dark"></i> Pièces détachées
                        </div>
                        <div class="col-6 d-flex align-items-center gap-2">
                            <i class="bx bx-refresh fs-5 text-dark"></i> Retours sous 14 jours
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# 📑 Détails & Caractéristiques #}
        <div class="row g-5 mt-4 pt-4 border-top border-light-subtle">
            {# Description #}
            <div class="col-lg-6">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <div class="rounded-circle bg-black text-white p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bx bx-file fs-5"></i>
                    </div>
                    <h3 class="fs-5 fw-bold text-dark mb-0">Description détaillée</h3>
                </div>

                {% if sections is not empty %}
                    <div class="d-flex flex-column gap-3">
                        {% for section in sections|sort((a,b) => a.sectionOrder <=> b.sectionOrder) %}
                            <div class="p-4 rounded-4 border border-light-subtle bg-white shadow-sm">
                                <h4 class="fs-6 fw-bold text-dark mb-2 d-flex align-items-center gap-2">
                                    <span class="badge bg-black text-white rounded-pill px-2 py-1" style="font-size: 0.65rem;">{{ loop.index }}</span>
                                    {{ section.title }}
                                </h4>
                                <div class="text-secondary small leading-relaxed">{{ section.content|raw }}</div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="p-4 rounded-4 border border-light-subtle bg-body-tertiary text-secondary small">
                        Aucune section descriptive supplémentaire pour ce modèle.
                    </div>
                {% endif %}
            </div>

            {# Spécifications #}
            <div class="col-lg-6">
                <div class="d-flex align-items-center gap-2 mb-4">
                    <div class="rounded-circle bg-black text-white p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="bx bx-slider-alt fs-5"></i>
                    </div>
                    <h3 class="fs-5 fw-bold text-dark mb-0">Spécifications techniques</h3>
                </div>

                {% if caracteristiques is not empty %}
                    {% set categories = {} %}
                    {% for c in caracteristiques %}
                        {% set cat = c.caracteristique.categorie ? c.caracteristique.categorie.name : 'Caractéristiques générales' %}
                        {% set categories = categories|merge({ (cat): (categories[cat]|default([]))|merge([c]) }) %}
                    {% endfor %}

                    <div class="d-flex flex-column gap-4">
                        {% for cat, items in categories %}
                            <div class="border border-light-subtle rounded-4 overflow-hidden shadow-sm bg-white">
                                <div class="bg-body-tertiary px-3 py-2 border-bottom border-light-subtle d-flex justify-content-between align-items-center">
                                    <span class="fs-6 fw-bold text-dark small text-uppercase tracking-wider">{{ cat }}</span>
                                    <span class="badge bg-light text-secondary border fw-normal" style="font-size: 0.65rem;">{{ items|length }} critères</span>
                                </div>
                                <div class="table-responsive mb-0">
                                    <table class="table table-sm table-striped align-middle mb-0 small">
                                        <tbody>
                                            {% for item in items %}
                                                <tr>
                                                    <td class="text-secondary ps-3 py-2 fw-medium" style="width: 45%;">
                                                        {{ item.caracteristique.name }}
                                                    </td>
                                                    <td class="text-dark pe-3 py-2 text-end fw-semibold">
                                                        {{ item.value }}
                                                    </td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="p-4 rounded-4 border border-light-subtle bg-body-tertiary text-secondary small">
                        Aucune fiche technique renseignée pour ce modèle.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Galerie photo avec Zoom Interactif #}
    <script>
        const trottZoomContainer = document.getElementById('trottZoomContainer');
        const trottMainImg = document.getElementById('mainProductImage');
        let trottIsZoomed = false;

        trottZoomContainer.addEventListener('click', function(e) {
            const rect = this.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;

            trottIsZoomed = !trottIsZoomed;

            if (trottIsZoomed) {
                trottMainImg.style.transformOrigin = `${x}% ${y}%`;
                trottMainImg.style.transform = 'scale(2.3)';
                this.style.cursor = 'zoom-out';
            } else {
                trottMainImg.style.transformOrigin = 'center center';
                trottMainImg.style.transform = 'scale(1)';
                this.style.cursor = 'zoom-in';
            }
        });

        trottZoomContainer.addEventListener('mousemove', function(e) {
            if (trottIsZoomed) {
                const rect = this.getBoundingClientRect();
                const x = ((e.clientX - rect.left) / rect.width) * 100;
                const y = ((e.clientY - rect.top) / rect.height) * 100;
                trottMainImg.style.transformOrigin = `${x}% ${y}%`;
            }
        });

        function changeMainImage(src, btn) {
            trottIsZoomed = false;
            trottMainImg.style.transform = 'scale(1)';
            trottZoomContainer.style.cursor = 'zoom-in';

            trottMainImg.style.opacity = '0.3';
            setTimeout(() => {
                trottMainImg.src = src;
                trottMainImg.style.opacity = '1';
            }, 150);

            document.querySelectorAll('.product-thumb-btn').forEach(el => {
                el.classList.remove('border-dark');
                el.classList.add('border-light-subtle');
            });
            btn.classList.remove('border-light-subtle');
            btn.classList.add('border-dark');
        }
    </script>
{% endblock %}
