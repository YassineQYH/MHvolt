{% extends 'base.html.twig' %}

{% block title %}Mon Panier — MHvolt{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/code-promo.js') }}"></script>
{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="mb-4">
        <span class="text-uppercase tracking-wider small fw-semibold text-muted">Tunnel de commande</span>
        <h1 class="display-6 fw-bold text-dark mt-1">Mon panier</h1>
        <p class="text-secondary small mb-0">Retrouvez l'ensemble des articles sélectionnés avant de finaliser votre commande.</p>
    </div>

    {% if cart|length > 0 %}
        {# === Calculs totaux et poids directs en TTC === #}
        {% set totalTTC = 0 %}
        {% set totalWeight = 0 %}
        {% set promoDiscount = cartObject.getDiscountTTC(promoService, allPromotions) %}

        {% for item in cart %}
            {% set priceTTC = item.product.price %}
            {% set totalItemTTC = priceTTC * item.quantity %}
            {% set itemWeight = item.product.weight|default(0) %}
            {% set totalWeight = totalWeight + (itemWeight * item.quantity) %}
            {% set totalTTC = totalTTC + totalItemTTC %}
        {% endfor %}

        {# === Liste des articles du panier === #}
        <div class="card border border-light-subtle rounded-4 shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light-subtle border-bottom border-light-subtle small text-uppercase text-secondary">
                        <tr>
                            <th class="ps-4 py-3">Article</th>
                            <th class="py-3 text-center">Quantité</th>
                            <th class="py-3">Poids</th>
                            <th class="py-3 text-end">Total TTC</th>
                            <th class="pe-4 py-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for item in cart %}
                            {% set priceTTC = item.product.price %}
                            {% set totalItemTTC = priceTTC * item.quantity %}
                            {% set totalItemRemise = promoDiscount > 0 ? totalItemTTC - (totalItemTTC / (totalTTC ?: 1) * promoDiscount) : totalItemTTC %}
                            {% set illustration = item.product.illustrations|first %}
                            {% set itemWeight = item.product.weight|default(0) %}
                            {% set itemType = item.type|default(item.product.type|default('trottinette')) %}
                            {% set showRoute = (itemType == 'accessory' or itemType == 'accessoire') ? 'accessory_show' : 'trottinette_show' %}

                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-body-tertiary border rounded-3 p-1 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; flex-shrink: 0;">
                                            <a href="{{ path(showRoute, { slug: item.product.slug }) }}">
                                                <img src="/uploads/{{ item.product.uploadDirectory }}/{{ illustration ? illustration.image : 'default.jpg' }}"
                                                     alt="{{ item.product.name }}"
                                                     class="img-fluid object-fit-contain" style="max-height: 48px;">
                                            </a>
                                        </div>
                                        <div>
                                            <a href="{{ path(showRoute, { slug: item.product.slug }) }}"
                                               class="fw-semibold text-dark text-decoration-none small d-block">
                                                {{ item.product.nameShort|default(item.product.name) }}
                                            </a>
                                            <span class="text-secondary small">{{ priceTTC|number_format(2, ',', ' ') }}&nbsp;€ / unité</span>
                                        </div>
                                    </div>
                                </td>

                                <td class="py-3 text-center">
                                    <span class="badge bg-light text-dark border px-3 py-2 fw-medium">x{{ item.quantity }}</span>
                                </td>

                                <td class="py-3 text-secondary small">
                                    {{ (itemWeight * item.quantity) }} kg
                                </td>

                                <td class="py-3 text-end">
                                    {% if promoDiscount > 0 %}
                                        <span class="text-muted text-decoration-line-through small">{{ totalItemTTC|number_format(2, ',', ' ') }}&nbsp;€</span><br>
                                        <span class="fw-bold text-dark">{{ totalItemRemise|number_format(2, ',', ' ') }}&nbsp;€</span>
                                    {% else %}
                                        <span class="fw-bold text-dark">{{ totalItemTTC|number_format(2, ',', ' ') }}&nbsp;€</span>
                                    {% endif %}
                                </td>

                                <td class="pe-4 py-3 text-end">
                                    <a href="{{ path('delete_to_cart', {'id': item.product.id, 'type': itemType}) }}"
                                       class="btn btn-outline-danger btn-sm border-0 rounded-circle"
                                       title="Supprimer">
                                        <i class="bx bx-trash fs-5"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# ========================================================
           1. FORMULAIRE CODE PROMO
           ======================================================== #}
        {% set promoCode = cartObject.getPromoCode() %}
        <div class="row justify-content-end mb-4">
            <div class="col-lg-5">
                <div class="card border border-light-subtle rounded-4 p-3 shadow-sm bg-white">
                    <form id="promoForm" action="{{ path('cart_apply_promo') }}" method="POST">
                        <label for="promoCode" class="form-label small fw-semibold text-dark mb-2">Code promotionnel</label>
                        <div class="input-group">
                            <input type="text"
                                   name="promo_code"
                                   id="promoCode"
                                   class="form-control rounded-start-pill py-2 px-3 small"
                                   placeholder="Ex : PROMO10"
                                   value="{{ promoCode ?? '' }}">
                            <input type="hidden" id="promoCodeValid" value="{{ promoCode ? 1 : 0 }}">
                            <button class="btn btn-dark rounded-end-pill px-3" type="submit">Appliquer</button>
                        </div>
                        <small id="promoMessage" class="text-danger d-block mt-1 small"></small>
                    </form>
                </div>
            </div>
        </div>

        {# ========================================================
           2. FORMULAIRE COMMANDE PRINCIPAL (ORDER_RECAP)
           ======================================================== #}
        {{ form_start(form_order, { action: path('order_recap'), method: 'POST', 'attr': {'id': 'form-order-submit'} }) }}
        <div class="row g-4 justify-content-between align-items-start">

            {# Colonne Gauche : Adresses de livraison #}
            <div class="col-lg-7">
                <div class="card border border-light-subtle rounded-4 p-4 shadow-sm mb-4 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="fs-6 fw-bold text-dark mb-0">Adresse de livraison</h2>
                        <a href="{{ path('account_address_add') }}" class="btn btn-outline-dark btn-sm rounded-pill">
                            <i class="bx bx-plus me-1"></i>Nouvelle adresse
                        </a>
                    </div>

                    {% if form_order.addresses is defined %}
                        <div class="row g-3">
                            {% for child in form_order.addresses %}
                                <div class="col-md-6">
                                    <div class="p-3 border rounded-3 h-100 bg-light-subtle position-relative">
                                        <div class="form-check">
                                            {{ form_widget(child, {'attr': {'class': 'form-check-input', 'id': child.vars.id}}) }}
                                            <label class="form-check-label fw-semibold text-dark small stretched-link cursor-pointer" for="{{ child.vars.id }}">
                                                Livrer à cette adresse
                                            </label>
                                        </div>
                                        <div class="text-secondary small mt-2 ps-4">
                                            {{ child.vars.label|nl2br }}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="alert alert-dark border small mb-0">
                            Aucune adresse renseignée. Veuillez <a href="{{ path('account_address_add') }}" class="alert-link">ajouter une adresse</a> avant de commander.
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Colonne Droite : Synthèse & Validation #}
            <div class="col-lg-5">
                {% set totalLivraison = price|default(0) %}
                {% set subtotalRemise = totalTTC - promoDiscount %}
                {% set grandTotal = subtotalRemise + totalLivraison %}

                <div class="card border border-light-subtle rounded-4 p-4 shadow-sm bg-body-tertiary">
                    <h2 class="fs-6 fw-bold text-dark mb-3">Récapitulatif financier</h2>

                    <div class="d-flex justify-content-between small text-secondary mb-2">
                        <span>Sous-total articles TTC</span>
                        <span class="text-dark">{{ totalTTC|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>

                    {% if promoDiscount > 0 %}
                        <div class="d-flex justify-content-between small text-success mb-2">
                            <span>Remise appliquée</span>
                            <span>-{{ promoDiscount|number_format(2, ',', ' ') }}&nbsp;€</span>
                        </div>
                        <div class="d-flex justify-content-between small text-secondary mb-2">
                            <span>Sous-total remisé TTC</span>
                            <span class="text-dark">{{ subtotalRemise|number_format(2, ',', ' ') }}&nbsp;€</span>
                        </div>
                    {% endif %}

                    <div class="d-flex justify-content-between small text-secondary mb-3 pb-3 border-bottom border-light-subtle">
                        <span>Frais d'expédition estimés</span>
                        <span class="text-dark">{{ totalLivraison|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-6 fw-bold text-dark">Total estimé TTC</span>
                        <span class="fs-4 fw-bold text-dark">{{ grandTotal|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>

                    {{ form_widget(form_order.submit, {
                        'attr': {'class': 'btn btn-dark rounded-pill py-3 fw-semibold w-100 text-center shadow-sm'}
                    }) }}
                </div>
            </div>
        </div>
        {{ form_end(form_order) }}

    {% else %}
        <div class="text-center py-5">
            <i class="bx bx-shopping-bag fs-1 text-secondary mb-3"></i>
            <h2 class="fs-5 fw-bold text-dark mb-2">Votre panier est actuellement vide</h2>
            <p class="text-secondary small mb-4">Découvrez nos trottinettes et accessoires pour commencer vos achats.</p>
            <a href="{{ path('nos_trottinettes') }}" class="btn btn-dark rounded-pill px-4 btn-sm">
                Découvrir nos trottinettes
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
