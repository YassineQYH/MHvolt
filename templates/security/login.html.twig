{% extends 'base.html.twig' %}

{% block title %}Connexion — MHvolt{% endblock %}

{% block content %}
<div class="container py-5" style="max-width: 480px;">
    {# En-tête #}
    <div class="text-center mb-4">
        <span class="text-uppercase tracking-wider small fw-semibold text-muted">Espace Membre</span>
        <h1 class="display-6 fw-bold text-dark mt-1">Connexion</h1>
        <p class="text-secondary small mb-0">Accédez à votre compte MHvolt et à vos commandes.</p>
    </div>

    {# Erreur de connexion Symfony Security #}
    {% if error is defined and error %}
        <div class="alert alert-dark border shadow-sm small text-center mb-4">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    <div class="card border border-light-subtle rounded-4 p-4 p-md-5 shadow-sm bg-white">
        {% if app.user %}
            <div class="text-center py-3">
                <div class="d-inline-flex align-items-center justify-content-center bg-body-tertiary border rounded-circle mb-3" style="width: 64px; height: 64px;">
                    <i class="fas fa-user-check fs-3 text-dark"></i>
                </div>
                <h2 class="fs-5 fw-bold text-dark mb-1">Vous êtes déjà connecté</h2>
                <p class="text-secondary small mb-4">Session active pour <strong>{{ app.user.userIdentifier }}</strong></p>

                <div class="d-grid gap-2">
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="/admin" class="btn btn-outline-dark btn-sm rounded-pill py-2">
                            <i class="fas fa-cog me-2"></i>Administration
                        </a>
                    {% endif %}
                    <a href="{{ path('account') }}" class="btn btn-dark btn-sm rounded-pill py-2">
                        <i class="fas fa-user me-2"></i>Accéder à mon compte
                    </a>
                    <a href="{{ path('app_logout') }}" class="btn btn-link text-danger text-decoration-none small mt-2">
                        Se déconnecter
                    </a>
                </div>
            </div>
        {% else %}
            <form method="post" action="{{ path('app_login') }}">
                <div class="mb-3">
                    <label for="inputEmail" class="form-label small fw-semibold text-dark">Adresse E-mail</label>
                    <input type="email"
                           name="email"
                           id="inputEmail"
                           class="form-control rounded-3 py-2 px-3 small"
                           placeholder="nom@exemple.com"
                           value="{{ last_username|default('') }}"
                           autocomplete="email"
                           required
                           autofocus>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="inputPassword" class="form-label small fw-semibold text-dark mb-0">Mot de passe</label>
                        <button type="button" class="btn btn-link text-secondary text-decoration-none p-0 small" onclick="toggleLoginPagePassword(this)" style="font-size: 0.75rem;">
                            Afficher
                        </button>
                    </div>
                    <input type="password"
                           name="password"
                           id="inputPassword"
                           class="form-control rounded-3 py-2 px-3 small"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="_remember_me" id="rememberMe">
                        <label class="form-check-label small text-secondary" for="rememberMe">
                            Se souvenir de moi
                        </label>
                    </div>
                    <a href="{{ path('reset_password') }}" class="small text-secondary text-decoration-none">
                        Mot de passe oublié ?
                    </a>
                </div>

                <button type="submit" class="btn btn-dark rounded-pill py-2 w-100 fw-semibold mb-3">
                    Se connecter
                </button>
            </form>

            <div class="text-center pt-3 border-top border-light-subtle">
                <span class="text-secondary small">Vous n'avez pas encore de compte ?</span>
                <button type="button" class="btn btn-link text-dark fw-bold text-decoration-none small p-0 ms-1" data-bs-toggle="modal" data-bs-target="#authModal">
                    Créer un compte
                </button>
            </div>
        {% endif %}
    </div>
</div>

<script>
    function toggleLoginPagePassword(btn) {
        const input = document.getElementById('inputPassword');
        if (input.type === 'password') {
            input.type = 'text';
            btn.textContent = 'Masquer';
        } else {
            input.type = 'password';
            btn.textContent = 'Afficher';
        }
    }
</script>
{% endblock %}
