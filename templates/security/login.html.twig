{% extends 'base.html.twig' %}

{% block title %}Connexion — MHvolt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/login-register.css') }}">
{% endblock %}

{% block content %}
<div class="container py-5 auth-container-sm">
    <div class="text-center mb-4">
        <span class="text-uppercase tracking-wider small fw-semibold text-muted">Espace Client</span>
        <h1 class="display-6 fw-bold text-dark mt-1">Connexion</h1>
        <p class="text-secondary small mb-0">
            Accédez à vos commandes, factures et adresses de livraison.
        </p>
    </div>

    {% if error %}
        <div class="alert alert-danger border border-danger-subtle rounded-3 small text-center mb-4">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {% for message in app.flashes('login_required') %}
        <div class="alert alert-dark border shadow-sm small text-center mb-4">
            {{ message }}
        </div>
    {% endfor %}

    <div class="card border border-light-subtle rounded-4 p-4 p-md-5 shadow-sm bg-white">
        <form method="post">
            <div class="mb-3">
                <label for="inputEmail" class="form-label small fw-semibold text-dark">Adresse e-mail</label>
                <input type="email"
                       value="{{ last_username }}"
                       name="email"
                       id="inputEmail"
                       class="form-control rounded-3 py-2 px-3 small"
                       autocomplete="email"
                       placeholder="nom@exemple.com"
                       required
                       autofocus>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label for="inputPassword" class="form-label small fw-semibold text-dark mb-0">Mot de passe</label>
                    <a href="{{ path('reset_password') }}" class="small text-secondary text-decoration-none">
                        Mot de passe oublié ?
                    </a>
                </div>
                <input type="password"
                       name="password"
                       id="inputPassword"
                       class="form-control rounded-3 py-2 px-3 small"
                       autocomplete="current-password"
                       placeholder="••••••••••••"
                       required>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn btn-dark rounded-pill py-2.5 w-100 fw-semibold mt-3 mb-3 shadow-sm" type="submit">
                Se connecter
            </button>
        </form>

        <div class="text-center pt-3 border-top border-light-subtle small text-secondary">
            Pas encore de compte ?
            <a href="{{ path('register') }}" class="text-dark fw-semibold text-decoration-none ms-1">
                Créer un compte
            </a>
        </div>
    </div>
</div>
{% endblock %}
