{% extends 'base.html.twig' %}

{% block title %}Définir votre mot de passe — MHvolt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/login-register.css') }}">
{% endblock %}

{% block content %}
<div class="container py-5 auth-container-sm">
    <div class="text-center mb-4">
        <span class="text-uppercase tracking-wider small fw-semibold text-muted">Sécurité & Accès</span>
        <h1 class="display-6 fw-bold text-dark mt-1">Définir un mot de passe</h1>
        <p class="text-secondary small mb-0">Choisissez un mot de passe sécurisé pour finaliser l'accès à votre compte.</p>
    </div>

    <div class="card border border-light-subtle rounded-4 p-4 p-md-5 shadow-sm bg-white">
        {{ form_start(form) }}
            <div class="d-flex flex-column gap-3">
                <div>
                    {{ form_row(form.password, {
                        'attr': {'class': 'form-control rounded-3 py-2 px-3 small', 'placeholder': '10 caractères minimum'}
                    }) }}
                </div>

                <div class="mt-2">
                    <button type="submit" class="btn btn-dark rounded-pill py-2.5 w-100 fw-semibold shadow-sm">
                        Valider et accéder à mon compte
                    </button>
                </div>
            </div>
        {{ form_end(form) }}

        <div class="text-center pt-3 mt-4 border-top border-light-subtle">
            <a href="{{ path('app_home') }}" class="text-secondary text-decoration-none small">
                <i class="fas fa-arrow-left me-1"></i>Retourner à l'accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}
