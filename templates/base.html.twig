<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{% block title %}MHvolt — Mobilité Électrique{% endblock %}</title>

        {% block stylesheets %}
            {# Polices & Icônes unifiées #}
            <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
            <link rel="stylesheet" href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css" />

            {# Bootstrap 5.3 & Animations #}
            <link rel="stylesheet" href="{{ asset('assets/css/bootstrap.min.css') }}">
            <link rel="stylesheet" href="https://unpkg.com/aos@2.3.1/dist/aos.css" />

            {# Styles du site unifiés #}
            <link rel="stylesheet" href="{{ asset('assets/css/theme-black-and-white.css') }}">
            <link rel="stylesheet" href="{{ asset('assets/css/msg-d-alerte.css') }}">
        {% endblock %}
    </head>

    <body class="d-flex flex-column min-vh-100 bg-white text-dark">
        {# 1. Bannière de maintenance réservée aux administrateurs #}
        {% if app.user and is_granted('ROLE_ADMIN') and site_config is defined and site_config.isMaintenanceEnabled() %}
            <div class="bg-danger text-white text-center py-2 px-3 small fw-bold fixed-top" style="z-index: 1070;">
                <i class="fas fa-tools me-2"></i>MODE MAINTENANCE ACTIF — Accès restreint aux visiteurs
            </div>
        {% endif %}

        {# 2. Notifications Flash flottantes #}
        <div class="flash-container">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash {{ label }}" onclick="this.style.opacity='0'; setTimeout(() => this.remove(), 250);" role="alert" style="cursor: pointer;">
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        {# 3. En-tête et Navigation principale #}
        <header>
            {% block menu %}
                {{ include('partials/menu.html.twig') }}
            {% endblock %}

            {% block carrousel %}{% endblock %}
        </header>

        {# 4. Contenu principal #}
        <main class="flex-grow-1">
            {% block content %}{% endblock %}
        </main>

        {# 5. Pied de page #}
        <footer id="footer" class="mt-auto">
            {% block footer %}
                {{ include('partials/footer.html.twig') }}
            {% endblock %}
        </footer>

        {# 6. Modale d'authentification #}
        {% block login %}
            {{ include('partials/login-register.html.twig') }}
        {% endblock %}

        {# 7. Modales de contact#}
        {% block contact %}
            {{ include('partials/contact-modal.html.twig') }}
        {% endblock %}


        {# 8. Scripts JavaScript #}
        {% block javascripts %}
            {# jQuery #}
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

            {# Bootstrap 5.3 Bundle (contient Popper.js) #}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

            {# Animations AOS #}
            <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
            <script>
                document.addEventListener('DOMContentLoaded', function() {
                    AOS.init({
                        once: true,
                        duration: 600,
                        offset: 50
                    });

                    // Ouverture automatique de la modale si ?login=1
                    const urlParams = new URLSearchParams(window.location.search);
                    if (urlParams.has('login')) {
                        const authModalEl = document.getElementById('authModal');
                        if (authModalEl) {
                            const authModal = new bootstrap.Modal(authModalEl);
                            authModal.show();
                        }
                    }

                    // Bascule automatique sur l'onglet inscription en cas d'erreur
                    {% if app.flashes('register_error') is not empty %}
                        const authModalEl = document.getElementById('authModal');
                        if (authModalEl) {
                            const authModal = new bootstrap.Modal(authModalEl);
                            authModal.show();
                            const registerTab = document.getElementById('register-tab');
                            if (registerTab) {
                                bootstrap.Tab.getOrCreateInstance(registerTab).show();
                            }
                        }
                    {% endif %}
                });
            </script>

            {# Script Panier #}
            <script src="{{ asset('assets/js/cart.js') }}"></script>
        {% endblock %}
    </body>
</html>
