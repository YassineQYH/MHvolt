{% extends 'base.html.twig' %}

{% block title %}Validation de commande — MHvolt{% endblock %}

{% block content %}
<div class="container py-5">
    {% set promoDiscount = promoDiscount|default(0) %}
    {% set promoTitreAffiche = promoTitre|default(promoCode|default('')) %}

    <div class="mb-4">
        <span class="text-uppercase tracking-wider small fw-semibold text-muted">Étape finale</span>
        <h1 class="display-6 fw-bold text-dark mt-1">Validation de la commande</h1>
        <p class="text-secondary small mb-0">Vérifiez vos coordonnées de livraison et le montant avant de procéder au règlement.</p>
    </div>

    <div class="row g-4">
        {# Colonne Gauche : Adresse de livraison #}
        <div class="col-lg-6">
            <div class="card border border-light-subtle rounded-4 p-4 shadow-sm h-100 bg-white">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <i class="fas fa-map-marker-alt text-dark fs-5"></i>
                    <h2 class="fs-6 fw-bold text-dark mb-0">Adresse de livraison</h2>
                </div>

                {% if delivery is defined and delivery is not empty %}
                    <div class="bg-body-tertiary border rounded-3 p-3 small text-secondary leading-relaxed mb-3">
                        {{ delivery|raw }}
                    </div>
                    <div class="small">
                        <a href="{{ path('cart') }}" class="text-secondary text-decoration-none">
                            <i class="fas fa-arrow-left me-1"></i>Changer d'adresse dans le panier
                        </a>
                    </div>
                {% else %}
                    <div class="alert alert-dark border small mb-0">
                        Aucune adresse sélectionnée. Veuillez <a href="{{ path('account_address_add') }}" class="alert-link text-decoration-underline">ajouter une adresse</a>.
                    </div>
                {% endif %}
            </div>
        </div>

        {# Colonne Droite : Récapitulatif Articles & Paiement #}
        <div class="col-lg-6">
            <div class="card border border-light-subtle rounded-4 p-4 shadow-sm bg-body-tertiary">
                <h2 class="fs-6 fw-bold text-dark mb-3">Détail des articles</h2>

                {# Calcul du total TTC direct #}
                {% set totalTTC = 0 %}
                {% for item in cart %}
                    {% set priceTTC = item.product.price %}
                    {% set totalItemTTC = priceTTC * item.quantity %}
                    {% set totalTTC = totalTTC + totalItemTTC %}
                {% endfor %}

                <div class="d-flex flex-column gap-3 mb-4">
                    {% for key, item in cart %}
                        {% set priceTTC = item.product.price %}
                        {% set totalItemTTC = priceTTC * item.quantity %}
                        {% set totalItemRemise = promoDiscount > 0 ? totalItemTTC - (totalItemTTC / (totalTTC ?: 1) * promoDiscount) : totalItemTTC %}
                        {% set illustration = item.product.illustrations|first %}

                        <div class="d-flex align-items-center justify-content-between gap-3 pb-2 border-bottom border-light-subtle">
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-white border rounded-3 p-1 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; flex-shrink: 0;">
                                    <img src="/uploads/{{ item.product.uploadDirectory }}/{{ illustration ? illustration.image : 'default.jpg' }}"
                                         alt="{{ item.product.name }}"
                                         class="img-fluid object-fit-contain" style="max-height: 40px;">
                                </div>
                                <div>
                                    <span class="fw-semibold text-dark small d-block">{{ item.product.nameShort|default(item.product.name) }}</span>
                                    <span class="text-secondary small">Qté : {{ item.quantity }}</span>
                                </div>
                            </div>

                            <div class="text-end">
                                {% if promoDiscount > 0 %}
                                    <span class="text-muted text-decoration-line-through small" style="font-size: 0.75rem;">
                                        {{ totalItemTTC|number_format(2, ',', ' ') }}&nbsp;€
                                    </span><br>
                                    <span class="fw-bold text-dark small">
                                        {{ totalItemRemise|number_format(2, ',', ' ') }}&nbsp;€
                                    </span>
                                {% else %}
                                    <span class="fw-semibold text-dark small">{{ totalItemTTC|number_format(2, ',', ' ') }}&nbsp;€</span>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Totaux financiers #}
                {% set subtotalRemise = promoDiscount > 0 ? (totalTTC - promoDiscount) : totalTTC %}
                {% set grandTotal = subtotalRemise + price|default(0) %}

                <div class="d-flex justify-content-between small text-secondary mb-2">
                    <span>Total articles TTC</span>
                    <span class="text-dark">{{ totalTTC|number_format(2, ',', ' ') }}&nbsp;€</span>
                </div>

                {% if promoDiscount > 0 %}
                    <div class="d-flex justify-content-between small text-success mb-2">
                        <span>Réduction ({% if promoTitreAffiche %}{{ promoTitreAffiche }}{% else %}Appliquée{% endif %})</span>
                        <span>-{{ promoDiscount|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>
                    <div class="d-flex justify-content-between small text-secondary mb-2">
                        <span>Sous-total remisé TTC</span>
                        <span class="text-dark">{{ subtotalRemise|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>
                {% endif %}

                <div class="d-flex justify-content-between small text-secondary mb-3 pb-3 border-bottom border-light-subtle">
                    <span>Frais de livraison</span>
                    <span class="text-dark">{{ price|default(0)|number_format(2, ',', ' ') }}&nbsp;€</span>
                </div>

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <div>
                        <span class="fs-6 fw-bold text-dark d-block">Montant total</span>
                        <span class="text-secondary small" style="font-size: 0.75rem;">TVA incluse</span>
                    </div>
                    <span class="fs-4 fw-bold text-dark">{{ grandTotal|number_format(2, ',', ' ') }}&nbsp;€</span>
                </div>

                {% if delivery is defined and delivery is not empty %}
                    <a href="{{ path('stripe_create_session', {'reference': reference}) }}"
                       class="btn btn-dark rounded-pill py-3 fw-semibold w-100 text-center shadow-sm">
                        <i class="fas fa-lock me-2"></i>Payer | {{ grandTotal|number_format(2, ',', ' ') }}&nbsp;€
                    </a>
                {% else %}
                    <button class="btn btn-secondary rounded-pill py-3 fw-semibold w-100 text-center" disabled>
                        Veuillez renseigner une adresse
                    </button>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
