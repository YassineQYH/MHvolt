{% extends 'base.html.twig' %}

{% block title %}Modifier mon mot de passe — MHvolt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/account.css') }}">
{% endblock %}

{% block content %}
<div class="container py-5 account-form-container-sm">
    <div class="mb-4">
        <a href="{{ path('account') }}" class="text-secondary text-decoration-none small mb-2 d-inline-block">
            <i class="bx bx-arrow-back me-1"></i>Retour à mon compte
        </a>
        <h1 class="display-6 fw-bold text-dark mb-1">Sécurité du compte</h1>
        <p class="text-secondary small mb-0">Mettez à jour votre mot de passe pour sécuriser vos accès.</p>
    </div>

    {% if notification %}
        <div class="alert alert-dark border shadow-sm small mb-4 text-center">
            {{ notification }}
        </div>
    {% endif %}

    <div class="card border border-light-subtle rounded-4 p-4 p-md-5 shadow-sm bg-white">
        {{ form_start(form) }}
            <div class="d-flex flex-column gap-3">
                <div>
                    {{ form_row(form.old_password, {
                        'attr': {'class': 'form-control rounded-3 py-2 px-3 small', 'placeholder': '••••••••••••'}
                    }) }}
                </div>

                <div>
                    {{ form_row(form.new_password.first, {
                        'attr': {'class': 'form-control rounded-3 py-2 px-3 small', 'placeholder': 'Nouveau mot de passe'}
                    }) }}
                </div>

                <div>
                    {{ form_row(form.new_password.second, {
                        'attr': {'class': 'form-control rounded-3 py-2 px-3 small', 'placeholder': 'Confirmez le nouveau mot de passe'}
                    }) }}
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-dark rounded-pill w-100 py-2 fw-semibold">
                        Mettre à jour le mot de passe
                    </button>
                </div>
            </div>
        {{ form_end(form, { render_rest: false }) }}
    </div>
</div>
{% endblock %}
