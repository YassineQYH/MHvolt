<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture {{ order.reference }}</title>
    <link rel="stylesheet" href="{{ app.project_dir ~ '/public/assets/css/invoice.css' }}">
</head>
<body class="invoice-pdf">

    {# En-tête #}
    <div class="invoice-header">
        <table class="invoice-header-table">
            <tr>
                <td>
                    <div class="invoice-brand">MHVOLT</div>
                    <div style="color: #4b5563;">
                        51 Boulevard Vincent Auriol<br>
                        4031 Angleur, BE<br>
                        contact@mhvolt.com
                    </div>
                </td>
                <td class="invoice-doc-title">
                    <h1>FACTURE</h1>
                    <div><strong>Réf :</strong> {{ order.reference }}</div>
                    <div><strong>Date :</strong> {{ order.createdAt|date('d/m/Y') }}</div>
                    <div><strong>Statut :</strong> Payée</div>
                </td>
            </tr>
        </table>
    </div>

    {# Coordonnées client #}
    <table class="invoice-addresses">
        <tr>
            <td>
                <div class="invoice-section-label">Émetteur</div>
                <strong>MHvolt Mobilité Électrique</strong><br>
                Service Ventes & Expéditions
            </td>
            <td>
                <div class="invoice-section-label">Facturé à</div>
                <strong>{{ order.user.firstName }} {{ order.user.lastName }}</strong><br>
                {{ order.delivery|raw }}
            </td>
        </tr>
    </table>

    {# Tableau des lignes de commande #}
    <table class="invoice-items-table">
        <thead>
            <tr>
                <th>Désignation</th>
                <th class="text-center">Qté</th>
                <th class="text-right">Prix unit. TTC</th>
                <th class="text-right">TVA</th>
                <th class="text-right">Total TTC</th>
            </tr>
        </thead>
        <tbody>
            {% set totalProduitsTTC = 0 %}
            {% set totalHT = 0 %}

            {% for item in order.orderDetails %}
                {% set unitTTC = item.priceTtc > 0 ? item.priceTtc : (item.price * (1 + item.tva / 100)) %}
                {% set lineTotalTTC = item.totalTtc > 0 ? item.totalTtc : (unitTTC * item.quantity) %}
                {% set tvaRate = item.tva|default(21) %}
                {% set lineHT = lineTotalTTC / (1 + (tvaRate / 100)) %}

                {% set totalProduitsTTC = totalProduitsTTC + lineTotalTTC %}
                {% set totalHT = totalHT + lineHT %}

                <tr>
                    <td><strong>{{ item.product }}</strong></td>
                    <td class="text-center">{{ item.quantity }}</td>
                    <td class="text-right">{{ unitTTC|number_format(2, ',', ' ') }} €</td>
                    <td class="text-right">{{ tvaRate }}%</td>
                    <td class="text-right">{{ lineTotalTTC|number_format(2, ',', ' ') }} €</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Totaux #}
    {% set promo = order.promoReduction ?? 0 %}
    {% set totalBrutTTC = totalProduitsTTC + promo %}
    {% set totalTVA = totalProduitsTTC - totalHT %}
    {% set totalCommande = totalProduitsTTC + order.carrierPrice %}

    <table class="invoice-totals-table">
        {% if promo > 0 %}
        <tr>
            <td>Sous-total articles :</td>
            <td class="text-right">{{ totalBrutTTC|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td class="invoice-discount-text">Réduction ({{ order.promoTitre ?? order.promoCode }}) :</td>
            <td class="text-right invoice-discount-text">-{{ promo|number_format(2, ',', ' ') }} €</td>
        </tr>
        {% endif %}
        <tr>
            <td>Sous-total articles TTC :</td>
            <td class="text-right">{{ totalProduitsTTC|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td>Dont montant HT :</td>
            <td class="text-right">{{ totalHT|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td>Dont TVA incluse :</td>
            <td class="text-right">{{ totalTVA|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr>
            <td>Frais d'expédition :</td>
            <td class="text-right">{{ order.carrierPrice|number_format(2, ',', ' ') }} €</td>
        </tr>
        <tr class="total-line">
            <td>Total TTC acquitté :</td>
            <td class="text-right">{{ totalCommande|number_format(2, ',', ' ') }} €</td>
        </tr>
    </table>

    {# Pied de page légal #}
    <div class="invoice-footer">
        MHvolt — Numéro d'entreprise & TVA intracommunautaire : BE 0000.000.000 &bull; Facture acquittée électroniquement.
    </div>

</body>
</html>
