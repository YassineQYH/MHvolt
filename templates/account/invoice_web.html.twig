{% extends 'base.html.twig' %}

{% block title %}Facture {{ order.reference }} — MHvolt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/invoice.css') }}">
{% endblock %}

{% block content %}
<div class="container py-5 invoice-wrapper">
    {# Barre d'action supérieure #}
    <div class="d-flex justify-content-between align-items-center mb-4 d-print-none">
        <a href="{{ path('account_order_show', { reference: order.reference }) }}" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="bx bx-arrow-back me-1"></i>Retour à la commande
        </a>
        <div class="d-flex gap-2">
            <button onclick="window.print();" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                <i class="bx bx-printer me-1"></i>Imprimer
            </button>
            <a href="{{ path('account_order_invoice', { reference: order.reference }) }}?download=1" class="btn btn-dark btn-sm rounded-pill px-3">
                <i class="bx bx-download me-1"></i>Télécharger en PDF
            </a>
        </div>
    </div>

    {# Feuille Facture #}
    <div class="card border border-light-subtle rounded-4 p-4 p-md-5 shadow-sm bg-white">
        {# En-tête société & facture #}
        <div class="d-flex justify-content-between align-items-start border-bottom border-light-subtle pb-4 mb-4">
            <div>
                <h2 class="invoice-brand mb-1">MHVOLT</h2>
                <p class="text-secondary small mb-0">
                    51 Boulevard Vincent Auriol<br>
                    4031 Angleur, BE<br>
                    contact@mhvolt.com
                </p>
            </div>
            <div class="text-end">
                <span class="badge bg-light text-dark border mb-2">Facture acquittée</span>
                <h1 class="fs-5 fw-bold text-dark mb-1">N° {{ order.reference }}</h1>
                <span class="text-secondary small">Date : {{ order.createdAt|date('d/m/Y') }}</span>
            </div>
        </div>

        {# Destinataire #}
        <div class="row g-4 mb-5">
            <div class="col-sm-6">
                <h3 class="fs-6 fw-bold text-uppercase tracking-wider text-muted small mb-2">Facturé à</h3>
                <p class="text-dark fw-semibold small mb-1">{{ order.user.firstName }} {{ order.user.lastName }}</p>
                <div class="text-secondary small leading-relaxed">
                    {{ order.delivery|raw }}
                </div>
            </div>
            <div class="col-sm-6 text-sm-end">
                <h3 class="fs-6 fw-bold text-uppercase tracking-wider text-muted small mb-2">Paiement</h3>
                <p class="text-secondary small mb-1">Règlement : <strong>Carte bancaire (Stripe)</strong></p>
                <p class="text-secondary small mb-0">Statut : <strong>Payée</strong></p>
            </div>
        </div>

        {# Tableau des lignes de facturation #}
        <div class="table-responsive mb-4">
            <table class="table align-middle mb-0">
                <thead class="bg-light-subtle border-bottom border-light-subtle small text-uppercase text-secondary">
                    <tr>
                        <th class="ps-3 py-2">Désignation</th>
                        <th class="py-2 text-center">Qté</th>
                        <th class="py-2 text-end">Prix unit. TTC</th>
                        <th class="py-2 text-end">Taux TVA</th>
                        <th class="pe-3 py-2 text-end">Total TTC</th>
                    </tr>
                </thead>
                <tbody>
                    {% set totalProduitsTTC = 0 %}
                    {% set totalHT = 0 %}

                    {% for item in order.orderDetails %}
                        {% set unitTTC = item.priceTtc > 0 ? item.priceTtc : (item.price * (1 + item.tva / 100)) %}
                        {% set lineTotalTTC = item.totalTtc > 0 ? item.totalTtc : (unitTTC * item.quantity) %}
                        {% set tvaRate = item.tva|default(21) %}
                        {% set lineHT = lineTotalTTC / (1 + (tvaRate / 100)) %}

                        {% set totalProduitsTTC = totalProduitsTTC + lineTotalTTC %}
                        {% set totalHT = totalHT + lineHT %}

                        <tr>
                            <td class="ps-3 py-3 fw-semibold text-dark small">{{ item.product }}</td>
                            <td class="py-3 text-center small">x{{ item.quantity }}</td>
                            <td class="py-3 text-end text-secondary small">{{ unitTTC|number_format(2, ',', ' ') }}&nbsp;€</td>
                            <td class="py-3 text-end text-secondary small">{{ tvaRate }}%</td>
                            <td class="pe-3 py-3 text-end fw-semibold text-dark small">{{ lineTotalTTC|number_format(2, ',', ' ') }}&nbsp;€</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {# Totaux financiers #}
        {% set promo = order.promoReduction ?? 0 %}
        {% set totalBrutTTC = totalProduitsTTC + promo %}
        {% set totalTVA = totalProduitsTTC - totalHT %}
        {% set totalCommande = totalProduitsTTC + order.carrierPrice %}

        <div class="row justify-content-end">
            <div class="col-md-6 col-lg-5">
                <div class="d-flex flex-column gap-2 small border-top border-light-subtle pt-3">
                    {% if promo > 0 %}
                        <div class="d-flex justify-content-between text-secondary">
                            <span>Sous-total articles :</span>
                            <span class="text-dark">{{ totalBrutTTC|number_format(2, ',', ' ') }}&nbsp;€</span>
                        </div>
                        <div class="d-flex justify-content-between text-success">
                            <span>Réduction ({{ order.promoTitre ?? order.promoCode }}) :</span>
                            <span>-{{ promo|number_format(2, ',', ' ') }}&nbsp;€</span>
                        </div>
                    {% endif %}
                    <div class="d-flex justify-content-between text-secondary">
                        <span>Sous-total articles TTC :</span>
                        <span class="text-dark">{{ totalProduitsTTC|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary">
                        <span>Dont montant HT :</span>
                        <span class="text-dark">{{ totalHT|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary">
                        <span>Dont TVA incluse :</span>
                        <span class="text-dark">{{ totalTVA|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>
                    <div class="d-flex justify-content-between text-secondary pb-2 border-bottom border-light-subtle">
                        <span>Frais d'expédition :</span>
                        <span class="text-dark">{{ order.carrierPrice|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-baseline fs-6 fw-bold text-dark pt-1">
                        <span>Total TTC acquitté :</span>
                        <span class="fs-5">{{ totalCommande|number_format(2, ',', ' ') }}&nbsp;€</span>
                    </div>
                </div>
            </div>
        </div>

        {# Mentions bas de page #}
        <div class="invoice-footer mt-5">
            <p class="mb-1">MHvolt — Mobilité Électrique &bull; TVA intracommunautaire : BE 0000.000.000</p>
            <p class="mb-0">Facture générée automatiquement et acquittée par voie électronique.</p>
        </div>
    </div>
</div>
{% endblock %}
