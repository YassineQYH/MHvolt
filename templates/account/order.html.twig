{% extends 'base.html.twig' %}

{% block title %}Mes Commandes — MHvolt{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="text-uppercase tracking-wider small fw-semibold text-muted">Espace Client</span>
            <h1 class="display-6 fw-bold text-dark mt-1">Historique des commandes</h1>
        </div>
        <a href="{{ path('account') }}" class="btn btn-outline-dark btn-sm rounded-pill">
            <i class="bx bx-arrow-back me-1"></i>Retour au compte
        </a>
    </div>

    {% if orders|length == 0 %}
        <div class="text-center py-5 border rounded-4 bg-body-tertiary">
            <i class="bx bx-package fs-1 text-secondary mb-2"></i>
            <p class="text-secondary small mb-3">Vous n'avez pas encore passé de commande sur notre boutique.</p>
            <a href="{{ path('nos_trottinettes') }}" class="btn btn-dark btn-sm rounded-pill px-4">Explorer le catalogue</a>
        </div>
    {% else %}
        <div class="card border border-light-subtle rounded-4 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="bg-light-subtle border-bottom border-light-subtle small text-uppercase text-secondary">
                        <tr>
                            <th class="ps-4 py-3">Référence</th>
                            <th class="py-3">Statut</th>
                            <th class="py-3">Date</th>
                            <th class="py-3">Livraison</th>
                            <th class="py-3">Réduction</th>
                            <th class="py-3">Total TTC</th>
                            <th class="pe-4 py-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in orders %}
                            {% set productsTTC = 0 %}
                            {% for item in order.orderDetails %}
                                {% set lineHT = item.price * item.quantity %}
                                {% set tvaRate = (item.tva is not empty ? (item.tva / 100) : 0) %}
                                {% set lineTTC = lineHT * (1 + tvaRate) %}
                                {% set productsTTC = productsTTC + lineTTC %}
                            {% endfor %}
                            {% set promo = order.promoReduction ?? 0 %}

                            <tr>
                                <td class="ps-4 py-3">
                                    <span class="fw-semibold text-dark small font-monospace">{{ order.reference }}</span>
                                </td>
                                <td class="py-3">
                                    {% if order.paymentState == 0 %}
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-normal">Non payée</span>
                                    {% elseif order.paymentState == 1 %}
                                        {% if order.deliveryState == 0 %}
                                            <span class="badge bg-light text-secondary border fw-normal">En attente</span>
                                        {% elseif order.deliveryState == 1 %}
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-normal">Préparation</span>
                                        {% elseif order.deliveryState == 2 %}
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle fw-normal">En livraison</span>
                                        {% elseif order.deliveryState == 3 %}
                                            <span class="badge bg-success-subtle text-success border border-success-subtle fw-normal">Livrée</span>
                                        {% elseif order.deliveryState == 4 %}
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-normal">Annulée</span>
                                        {% endif %}
                                    {% endif %}
                                </td>
                                <td class="py-3 text-secondary small">{{ order.createdAt|date('d/m/Y') }}</td>
                                <td class="py-3 text-secondary small">{{ order.carrierPrice|number_format(2, ',', ' ') }} €</td>
                                <td class="py-3 text-secondary small">
                                    {% if promo > 0 %}
                                        <span class="text-success">-{{ promo|number_format(2, ',', ' ') }} €</span>
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td class="py-3 fw-bold text-dark small">
                                    {{ (productsTTC - promo + order.carrierPrice)|number_format(2, ',', ' ') }} €
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <a href="{{ path('account_order_show', { 'reference': order.reference }) }}"
                                       class="btn btn-outline-dark btn-sm rounded-pill px-3 py-1 fw-medium">
                                        Détails <i class="bx bx-right-arrow-alt"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}
