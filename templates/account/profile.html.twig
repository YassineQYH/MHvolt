{% extends 'base.html.twig' %}

{% block title %}Mes Informations — MHvolt{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('assets/css/account.css') }}">
{% endblock %}

{% block content %}
<div class="container py-5 account-form-container-sm">
    <div class="mb-4">
        <a href="{{ path('account') }}" class="text-secondary text-decoration-none small mb-2 d-inline-block">
            <i class="bx bx-arrow-back me-1"></i>Retour à mon compte
        </a>
        <h1 class="display-6 fw-bold text-dark mb-1">Mes informations personnelles</h1>
        <p class="text-secondary small mb-0">Modifiez vos données de contact associées à votre profil client.</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-dark border shadow-sm small mb-4">{{ message }}</div>
    {% endfor %}

    <div class="card border border-light-subtle rounded-4 p-4 p-md-5 shadow-sm bg-white">
        {{ form_start(form) }}
            <div class="d-flex flex-column gap-3">
                {{ form_row(form.firstname, {'attr': {'class': 'form-control rounded-3 py-2 px-3 small'}}) }}
                {{ form_row(form.lastname, {'attr': {'class': 'form-control rounded-3 py-2 px-3 small'}}) }}
                {{ form_row(form.tel, {'attr': {'class': 'form-control rounded-3 py-2 px-3 small'}}) }}

                <div>
                    {{ form_row(form.email, {'attr': {'class': 'form-control rounded-3 py-2 px-3 small bg-light', 'readonly': true}}) }}
                    <small class="text-secondary d-block mt-1 helper-text-xs">
                        Pour changer votre adresse email, veuillez <a href="{{ path('app_home') }}#contact" class="text-dark fw-semibold">contacter l'assistance</a>.
                    </small>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-dark rounded-pill w-100 py-2 fw-semibold">
                        Enregistrer les modifications
                    </button>
                </div>
            </div>
        {{ form_end(form, { render_rest: false }) }}
    </div>
</div>
{% endblock %}
