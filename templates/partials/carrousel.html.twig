{% block carrousel %}
    {% if headers is defined and headers|length > 0 %}
    <div id="homeHeroCarousel" class="carousel slide carousel-fade bg-black" data-bs-ride="carousel">
        {# Indicateurs sous forme de barres fines #}
        {% if headers|length > 1 %}
            <div class="carousel-indicators mb-4">
                {% for key, trott in headers %}
                    <button type="button"
                            data-bs-target="#homeHeroCarousel"
                            data-bs-slide-to="{{ key }}"
                            class="{% if loop.first %}active{% endif %}"
                            aria-current="{% if loop.first %}true{% endif %}"
                            aria-label="Diapositive {{ key + 1 }}"
                            style="width: 32px; height: 3px; border-radius: 2px;">
                    </button>
                {% endfor %}
            </div>
        {% endif %}

        {# Diapositives #}
        <div class="carousel-inner">
            {% for key, trott in headers %}
                <div class="carousel-item {% if loop.first %}active{% endif %}" style="height: 75vh; min-height: 480px;">
                    {# Image d'arrière-plan #}
                    <img src="/uploads/header/{{ trott.HeaderImage }}"
                         alt="{{ trott.slug }}"
                         class="d-block w-100 h-100 object-fit-cover opacity-75">

                    {# Voile dégradé sombre pour assurer le contraste #}
                    <div class="position-absolute top-0 start-0 w-100 h-100"
                         style="background: linear-gradient(180deg, rgba(9, 9, 11, 0.2) 0%, rgba(9, 9, 11, 0.7) 100%);">
                    </div>

                    {# Contenu textuel et CTA #}
                    <div class="carousel-caption d-flex flex-column justify-content-center align-items-start text-start top-0 bottom-0 start-0 end-0 px-4 px-md-5 mx-auto" style="max-width: 1200px;">
                        <span class="badge bg-white text-dark rounded-pill px-3 py-1 small fw-semibold text-uppercase tracking-wider mb-3">
                            Modèle Phare
                        </span>

                        <h1 class="display-4 fw-bold text-white tracking-tight mb-2" style="max-width: 750px;">
                            {{ trott.nameShort }}
                        </h1>

                        {% if trott.descriptionShort %}
                            <p class="fs-5 text-white-50 fw-normal mb-4" style="max-width: 600px;">
                                {{ trott.descriptionShort }}
                            </p>
                        {% endif %}

                        {% if trott.headerBtnTitle %}
                            <div>
                                <a href="{{ path('trottinette_show', {'slug': trott.slug}) }}"
                                   class="btn btn-light rounded-pill px-4 py-3 fw-semibold text-dark shadow-sm">
                                    {{ trott.headerBtnTitle }} <i class="fas fa-arrow-right ms-2 fs-6"></i>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {# Flèches de navigation #}
        {% if headers|length > 1 %}
            <button class="carousel-control-prev" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Précédent</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Suivant</span>
            </button>
        {% endif %}
    </div>
    {% endif %}
{% endblock %}
