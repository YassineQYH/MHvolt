{% set activePromos = promotions|default([]) %}

{% if activePromos is not empty %}
<section class="top-space text-center">
    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
        {% for promo in activePromos %}
            <div class="promo-banner" data-aos="fade-down" data-aos-duration="1000">
                <span class="promo-title">
                    🔥 {{ promo.titre }}
                </span>
            </div>
        {% endfor %}
    </div>
</section>
{% endif %}
