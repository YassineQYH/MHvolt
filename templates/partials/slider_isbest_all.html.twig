<section class="py-5 bg-white border-bottom border-light-subtle">
    <div class="container py-4">
        {# En-tête de section #}
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-uppercase tracking-wider small fw-semibold text-muted">Sélection</span>
                <h2 class="display-6 fw-bold text-dark mb-0">Nouveautés & Incontournables</h2>
            </div>
            <div class="d-none d-md-block text-secondary small">
                Découvrez nos derniers équipements homologués
            </div>
        </div>

        {# Grille / Slider de cartes #}
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            {# 🔹 Boucle Trottinettes #}
            {% for trottinette in trottinettes %}
                {% set image = trottinette.illustrations|first %}
                <div class="col" data-aos="fade-up" data-aos-duration="600">
                    <div class="card h-100 border border-light-subtle rounded-4 p-3 bg-white product-card transition-all">
                        {# Tag catégorie #}
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-light text-dark fw-normal border">Trottinette</span>
                            {% if trottinette.price is defined %}
                                <span class="fw-semibold text-dark small">{{ (trottinette.price / 100)|number_format(2, ',', ' ') }} €</span>
                            {% endif %}
                        </div>

                        {# Image du produit #}
                        <a href="{{ path('trottinette_show', { 'slug': trottinette.slug }) }}" class="d-flex align-items-center justify-content-center my-3 text-decoration-none" style="height: 200px;">
                            <img src="/uploads/trottinettes/{{ image ? image.image : 'default.jpg' }}"
                                 alt="{{ trottinette.name }}"
                                 class="img-fluid object-fit-contain h-100 w-100 product-img-zoom">
                        </a>

                        {# Détails & Lien #}
                        <div class="card-body p-0 pt-2 d-flex flex-column justify-content-end">
                            <h3 class="fs-6 fw-semibold text-dark mb-3 text-truncate">
                                <a href="{{ path('trottinette_show', { 'slug': trottinette.slug }) }}" class="text-dark text-decoration-none hover-underline">
                                    {{ trottinette.name }}
                                </a>
                            </h3>
                            <a href="{{ path('trottinette_show', { 'slug': trottinette.slug }) }}" class="btn btn-outline-dark rounded-pill w-100 btn-sm py-2 fw-medium">
                                Découvrir
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}

            {# 🔹 Boucle Accessoires #}
            {% for accessory in accessories %}
                {% set image = accessory.illustrations|first %}
                <div class="col" data-aos="fade-up" data-aos-duration="600">
                    <div class="card h-100 border border-light-subtle rounded-4 p-3 bg-white product-card transition-all">
                        {# Tag catégorie #}
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-light text-secondary fw-normal border">Accessoire</span>
                            {% if accessory.price is defined %}
                                <span class="fw-semibold text-dark small">{{ (accessory.price / 100)|number_format(2, ',', ' ') }} €</span>
                            {% endif %}
                        </div>

                        {# Image de l'accessoire #}
                        <a href="{{ path('accessory_show', { 'slug': accessory.slug }) }}" class="d-flex align-items-center justify-content-center my-3 text-decoration-none" style="height: 200px;">
                            <img src="/uploads/accessoires/{{ image ? image.image : 'default.jpg' }}"
                                 alt="{{ accessory.name }}"
                                 class="img-fluid object-fit-contain h-100 w-100 product-img-zoom">
                        </a>

                        {# Détails & Lien #}
                        <div class="card-body p-0 pt-2 d-flex flex-column justify-content-end">
                            <h3 class="fs-6 fw-semibold text-dark mb-3 text-truncate">
                                <a href="{{ path('accessory_show', { 'slug': accessory.slug }) }}" class="text-dark text-decoration-none hover-underline">
                                    {{ accessory.name }}
                                </a>
                            </h3>
                            <a href="{{ path('accessory_show', { 'slug': accessory.slug }) }}" class="btn btn-outline-dark rounded-pill w-100 btn-sm py-2 fw-medium">
                                Découvrir
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
