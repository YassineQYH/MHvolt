<section class="py-5 bg-white border-bottom border-light-subtle">
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <span class="text-uppercase tracking-wider small fw-semibold text-muted">Trottinettes</span>
                <h2 class="display-6 fw-bold text-dark mb-0">Nos Modèles Phares</h2>
            </div>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            {% for trottinette in trottinettes %}
                {% set image = trottinette.illustrations|first %}
                <div class="col" data-aos="fade-up" data-aos-duration="600">
                    <div class="card h-100 border border-light-subtle rounded-4 p-3 bg-white product-card">
                        <a href="{{ path('trottinette_show', { 'slug': trottinette.slug }) }}" class="d-flex align-items-center justify-content-center my-3 text-decoration-none" style="height: 200px;">
                            <img src="/uploads/trottinettes/{{ image ? image.image : 'default.jpg' }}"
                                 alt="{{ trottinette.name }}"
                                 class="img-fluid object-fit-contain h-100 w-100 product-img-zoom">
                        </a>
                        <div class="card-body p-0 pt-2 d-flex flex-column justify-content-end">
                            <h3 class="fs-6 fw-semibold text-dark mb-3 text-truncate">
                                <a href="{{ path('trottinette_show', { 'slug': trottinette.slug }) }}" class="text-dark text-decoration-none">
                                    {{ trottinette.name }}
                                </a>
                            </h3>
                            <a href="{{ path('trottinette_show', { 'slug': trottinette.slug }) }}" class="btn btn-outline-dark rounded-pill w-100 btn-sm py-2 fw-medium">
                                Voir le modèle
                            </a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
